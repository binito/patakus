DATABASE_URL="mysql://USER:STRONG_PASSWORD@localhost:3306/patakus"
JWT_SECRET="use_openssl_rand_hex_64_to_generate"
JWT_ACCESS_EXPIRES_IN="15m"   # access token — curto; não alterar sem razão
PORT=3001
UPLOAD_DIR="./uploads"

# Obrigatórias — servidor não arranca sem estas
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"
FRONTEND_URL=https://yourdomain.com
SEED_ADMIN_PASSWORD="strong_admin_password"

# Opcional — login/criação de conta com Google OAuth 2.0
API_URL=https://api.yourdomain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se ficar vazio, usa "$API_URL/auth/oauth/google/callback"
GOOGLE_REDIRECT_URI=
# Novas contas OAuth usam OPERATOR por defeito; define CLIENT_ADMIN/SUPER_ADMIN só se fizer sentido.
OAUTH_DEFAULT_ROLE=OPERATOR
# Opcional: associar automaticamente novas contas a um cliente existente
OAUTH_DEFAULT_CLIENT_ID=

# Opcional — Sentry error tracking (https://sentry.io, free tier)
# SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
